# Secrets — never commit
.env
.env.*
!.env.example

# Go build output
bench-cli.exe
bench-cli
*.exe

# Local bench data
claimsBench/data/

# Planning notes — kept locally, not part of the deliverable
claude docs/

# Scratch files from local testing — cookie jars hold live session tokens
ck.txt
c.txt
_o.html
_e.js

# Agent skills installed by `npx skills add` — tooling, not project code
.agents/

# Local Visual Studio workspace state
.vs/

# The demo storefront with the integration stripped out, generated by
# `npm run demo:clean-store` from demo-store/. Generated and never edited: it
# exists so the embed tag can be pasted in on camera, and anything typed into it
# is meant to be thrown away by the next regeneration.
demo-store-clean/

# Local Vercel integration fixture and deployment metadata. Keep the demo
# available for recordings without publishing it with the Chapman repository.
vercel-demo-store/

# Local Claude Code settings — may hold API keys
.claude/settings.local.json
