# CHAPMAN — environment reference.
#
# You almost certainly do not need to copy this. `npm run init` generates the
# secrets and appends them to the .env AT THE REPOSITORY ROOT, one directory up
# from here, which is the file `loadRootEnv()` reads. This exists so you can
# see the whole list in one place, and so a deployment that sets variables
# some other way knows what to set.
#
# Nothing here carries a VITE_ prefix, so none of it can reach a client bundle.
# That is the bundler refusing, not a convention to remember.

# ---- Required for a custom storefront --------------------------------------

# Signs shopper session tokens and our requests to your order feed. The NAME is
# whatever `secretEnv` says in chapman.config.json; the shape below is what
# `npm run init` generates. Rotating it signs every shopper out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SITE_SECRET_MYSTORE=

# ---- Strongly recommended ---------------------------------------------------

# Signs merchant console sessions. Without it, one is generated into
# <data dir>/.session-secret on first run — fine for a single process, wrong
# the moment there are two, because neither will accept the other's sessions.
# CONSOLE_SESSION_SECRET=

# Where this gateway answers. Used to build the recovery links sent to shoppers.
# GATEWAY_ORIGIN=https://chapman.yourshop.example

# Everything CHAPMAN writes: the ledger, placed orders, shopper memory, console
# accounts, feature switches. Defaults to agent-gateway/data/, which is inside a
# git checkout and inside a container image. Point it somewhere backed up.
# CHAPMAN_DATA_DIR=/var/lib/chapman
# CHAPMAN_DATABASE_PATH=/var/lib/chapman/chapman.sqlite
# DATABASE_URL=file:/var/lib/chapman/chapman.sqlite

# An explicit path to the site registry, so a container can mount one anywhere.
# CHAPMAN_CONFIG=/etc/chapman/chapman.config.json

# ---- Optional: the model ----------------------------------------------------

# Without this a deterministic reasoner answers instead. The shop still works,
# still stays in bounds, and replies are templated rather than written.
# OPENROUTER_API_KEY=

# Prefer one model for a given job. The value is a single model id, tried
# FIRST and then falling back to the built-in chain, so a model that is
# rate-limited upstream does not take the job down. Defaults are in
# openrouter.server.ts, and `npm run probe:models` shows what is answering now.
# OPENROUTER_MODEL_ASSISTANT=
# OPENROUTER_MODEL_ANALYST=
# OPENROUTER_MODEL_SUMMARISER=
# OPENROUTER_MODEL_GRADER=

# ---- Optional: payments -----------------------------------------------------

# The NAMES of these live in chapman.config.json; the values live here. Names
# are yours to choose — these are what `npm run init` suggests.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Without a webhook, settlement rides the browser return path and a buyer who
# closes the tab after paying gets no order.
# RAZORPAY_WEBHOOK_SECRET=

# ---- Optional: recovery phone calls -----------------------------------------

# All five are required together. Half-configured voice fails at call time
# rather than at start, so `npm run doctor` warns about a partial set.
# SARVAM_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# PUBLIC_ORIGIN=            # the publicly reachable origin Twilio fetches TwiML from
# VOICE_QUIET_HOURS_TEST_NUMBER=  # optional E.164 handset for manual tests after hours

# Set only when Chapman runs immediately behind one reverse proxy that replaces
# X-Forwarded-For and forwards the public protocol. This lets public-route rate
# limits use the original client IP and keeps HTTPS dashboard form origins
# consistent. The bundled ngrok service is one such proxy.
# CHAPMAN_TRUST_PROXY=1

# On SIGTERM/SIGINT, stop accepting work, drain active responses and tracked
# background jobs, then checkpoint SQLite. Range: 1000-120000; default: 20000.
# Keep this below the container platform's termination grace period.
# CHAPMAN_SHUTDOWN_TIMEOUT_MS=20000

# ---- Optional: Shopify ------------------------------------------------------

# Only for running against a Shopify dev store. The custom-storefront path —
# widget, console, agent surface, order access — needs none of it, and
# app/shopify.server.ts builds Shopify on first use, so leaving these unset
# costs nothing at startup.
#
# Real values only. Placeholders used to live here, and all they did was make
# the dev server look healthy while `npm start` was broken.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=read_products
