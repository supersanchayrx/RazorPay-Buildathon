# Copy to .env.embed, then start the dev server with `--mode embed`.
#
# Vite only loads `.env.<mode>`, so without that flag none of this is read and
# the app fails with "Detected an empty appUrl configuration" — an error that
# says nothing about the actual cause. That is the single most likely way a
# first run goes wrong.
#
# These are placeholders. The custom-site path (embed widget, console, order
# access) works with exactly these values and no Shopify account at all; real
# credentials are only needed to run against a Shopify dev store.

SHOPIFY_API_KEY=dev_placeholder
SHOPIFY_API_SECRET=dev_placeholder
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products

# Optional. Signs merchant console sessions. Generated into data/.session-secret
# on first run if unset, which is fine for development and wrong for anything
# with more than one process.
# CONSOLE_SESSION_SECRET=

# Optional. The secret shared with the demo storefront — it signs shopper
# session tokens and our requests to the merchant's order feed. Must match the
# demo store's `-secret` flag. Defaults to a value committed in sites.server.ts,
# which is acceptable only because it is a fixture.
# SITE_SECRET_NILGIRIPOST=
