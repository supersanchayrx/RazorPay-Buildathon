    "site:enable-razorpay": "node scripts/configure-razorpay.mjs",
    "probe:ucp": "node scripts/probe-ucp.mjs",
    "probe:models": "node scripts/probe-models.mjs",
    "probe:model": "node scripts/probe-model.mjs",
    "probe:analyst": "node scripts/probe-analyst.mjs",
    "dev:gateway": "vite --port 3000 --strictPort --mode embed",
    "shop-as-agent": "node scripts/shop-as-agent.mjs",
    "demo:clean-store": "node scripts/demo-clean-store.mjs"
  },
  "type": "module",
  "engines": {
